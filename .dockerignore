# The UI is delivered as ui/dist.zip and unpacked during the build. A locally
# extracted ui/dist must not be copied in: unzip -o only overwrites matching
# names, so stale content-hashed chunks would survive into the image.
ui/dist

# Build output and local state. The control database is created by the program
# at SYNC_DB_PATH on first start; a developer's local copy must not reach the
# build context, which is how one admin password and one set of sync tasks ended
# up in every published image.
sync
sync.db
sync.db-wal
sync.db-shm

# Not needed to build, and keeps credentials out of the build context
.git
docs
